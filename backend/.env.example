# 777c8 Career OS — Environment Configuration
# Copy this to .env and configure your settings

# OpenAI (required for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/career_os.db

# Application
DEBUG=true
APP_NAME=777c8 Career OS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LaTeX (path to pdflatex binary, usually auto-detected)
# PDFLATEX_PATH=pdflatex
