# ====================================================================
# 777c8 Career OS — Global Environment Configuration Template
# Copy this file to `.env` and fill in your details.
# ====================================================================

# ── Backend Configuration ───────────────────────────────────────────
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./storage/career_os.db

# LaTeX Path (default is "pdflatex". Set absolute path if not in system PATH)
# Examples:
# Windows: PDFLATEX_PATH=C:\Program Files\MiKTeX\miktex\bin\x64\pdflatex.exe
# Linux: PDFLATEX_PATH=pdflatex
PDFLATEX_PATH=pdflatex

# Unified LLM Provider Settings (Optional fallback values)
# (Note: API Keys are securely managed and encrypted within the app settings,
# but can be defined here as default fallback values if desired)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Cache Settings
ENABLE_PROMPT_CACHE=true
CACHE_TTL_SECONDS=3600

# ── Frontend Configuration ──────────────────────────────────────────
# URL of the Backend API (without trailing slash)
VITE_API_URL=http://localhost:8000/api/v1
