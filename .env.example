# ====================================================================
# 777c8 Career OS — Global Environment Configuration Template
# Copy this file to `.env` and fill in your details.
# ====================================================================

# ── Backend Configuration ───────────────────────────────────────────
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./storage/career_os.db

# Master Credentials for Secure Vault Auto-Setup/Unlock
MASTER_PASSWORD=

# Custom Storage Directories (Leave blank for default inside backend/storage/)
STORAGE_PATH=
UPLOAD_PATH=
GENERATED_PATH=
BACKUP_PATH=
LOG_PATH=

# Unified LLM Provider Keys & Defaults
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# Cache Settings
ENABLE_PROMPT_CACHE=true
CACHE_TTL_SECONDS=3600

# ── LaTeX Path ──────────────────────────────────────────────────────
# Windows: PDFLATEX_PATH=C:\Program Files\MiKTeX\miktex\bin\x64\pdflatex.exe
# Linux: PDFLATEX_PATH=pdflatex
PDFLATEX_PATH=pdflatex

# ── Frontend Configuration ──────────────────────────────────────────
# URL of the Backend API (without trailing slash)
VITE_API_URL=http://localhost:8000/api/v1
